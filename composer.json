{
    "name": "jacyimp/memorable-otp",
    "description": "Human-friendly numeric verification code generator",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "otp",
        "verification-code",
        "one-time-password",
        "memorable",
        "php"
    ],
    "autoload": {
        "psr-4": {
            "JacyImp\\MemorableOtp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JacyImp\\MemorableOtp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "coverage": [
            "@php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-clover=.phpunit.cache/coverage.xml --coverage-text --only-summary-for-coverage-text",
            "@php tools/check-coverage.php .phpunit.cache/coverage.xml"
        ],
        "mutation": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d xdebug.mode=coverage vendor/bin/infection --no-progress"
        ],
        "score": "php tools/score.php",
        "calibrate": "php tools/calibrate.php",
        "check": [
            "@composer validate --strict",
            "@cs",
            "@analyse",
            "@test"
        ]
    },
    "authors": [
        {
            "name": "Jacy"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0.4",
        "slevomat/coding-standard": "^8.31",
        "phpstan/phpstan": "^2.2.12",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^11.5.50",
        "infection/infection": "^0.31.9"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true
        }
    }
}
